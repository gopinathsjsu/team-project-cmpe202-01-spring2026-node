# Optional: boot-time stack on EC2 (Amazon Linux / systemd)
#
# Install:
#   sudo cp node-docker-compose.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now node-docker-compose.service
#
# Edit WorkingDirectory if your compose file is not under /opt/node-app/node_backend_app.
# Requires Docker daemon (ec2-user must be in `docker` group, or run this unit as root).

[Unit]
Description=Node event platform (docker compose)
After=docker.service network-online.target nginx.service
Wants=network-online.target nginx.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/node-app/node_backend_app
# Project name matches top-level `name:` in docker-compose.yaml (stable DNS / volumes).
ExecStart=/usr/bin/docker compose -p node-platform up -d
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
